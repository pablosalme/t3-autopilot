{
  "name": "t3-autopilot",
  "version": "0.1.0",
  "description": "MCP server that recommends provider, model and effort for each delegate_task in T3 Code, from a family-based policy and the models you actually have.",
  "type": "module",
  "bin": {
    "t3-autopilot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "policy/default.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "t3code",
    "t3-code",
    "mcp",
    "model-context-protocol",
    "orchestrator",
    "model-routing",
    "delegate_task"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablosalme/t3-autopilot.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
