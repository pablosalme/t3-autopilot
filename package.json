{
  "name": "t3-autopilot",
  "version": "0.1.0",
  "description": "MCP server that recommends the provider, model and reasoning effort for each T3 Code child task, from a family-based policy and the models you actually have.",
  "keywords": [
    "t3code",
    "t3-code",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "orchestrator",
    "delegate_task",
    "model-routing",
    "model-selection",
    "ai-agents",
    "llm"
  ],
  "homepage": "https://github.com/pablosalme/t3-autopilot#readme",
  "bugs": {
    "url": "https://github.com/pablosalme/t3-autopilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablosalme/t3-autopilot.git"
  },
  "license": "MIT",
  "author": {
    "name": "pablosalme",
    "url": "https://github.com/pablosalme"
  },
  "type": "module",
  "bin": {
    "t3-autopilot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "policy/default.yaml",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --test test/e2e/stdio.e2e.mjs",
    "test:pack": "node scripts/pack-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
